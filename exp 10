import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split, StratifiedKFold
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import BaggingClassifier, AdaBoostClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

SEED = 42

# Load the Iris dataset
iris = load_iris()
X = iris.data
y = iris.target

flowers = pd.DataFrame(X, columns=iris.feature_names)
flowers['species'] = iris.target_names[y]

print(flowers.head().to_string(index=False))
print('\nNumber of flowers:', len(X))
print('Missing measurements:', np.isnan(X).sum())
print('Species:', iris.target_names)

# Split the dataset into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=SEED
)

print('Flowers available for training and validation:', len(X_train))
print('Flowers reserved for the final test:', len(X_test))

# Evaluate accuracy and macro F1 score
def evaluate_predictions(actual, predicted):
    accuracy = accuracy_score(actual, predicted)
    f1 = f1_score(
        actual,
        predicted,
        labels=[0, 1, 2],
        average='macro',
        zero_division=0
    )
    return accuracy, f1

# Bootstrap sampling and out-of-bag evaluation
rng = np.random.default_rng(SEED)
number_of_flowers = len(X_train)
all_indices = np.arange(number_of_flowers)

sample_indices = rng.choice(
    all_indices,
    size=number_of_flowers,
    replace=True
)

unique_indices = np.unique(sample_indices)
oob_indices = np.setdiff1d(all_indices, unique_indices)

print('First 20 sampled row numbers:', sample_indices[:20])
print('Total draws:', len(sample_indices))
print('Different flowers selected:', len(unique_indices))
print('Flowers left for OOB evaluation:', len(oob_indices))

# Repeat bootstrap evaluation 100 times
rng = np.random.default_rng(SEED)
bootstrap_accuracy = []
bootstrap_f1 = []

for repetition in range(100):
    sample_indices = rng.choice(
        all_indices,
        size=number_of_flowers,
        replace=True
    )

    oob_indices = np.setdiff1d(
        all_indices,
        np.unique(sample_indices)
    )

    if len(oob_indices) == 0:
        continue

    model = DecisionTreeClassifier(
        max_depth=3,
        random_state=SEED
    )

    model.fit(
        X_train[sample_indices],
        y_train[sample_indices]
    )

    predictions = model.predict(X_train[oob_indices])

    accuracy, f1 = evaluate_predictions(
        y_train[oob_indices],
        predictions
    )

    bootstrap_accuracy.append(accuracy)
    bootstrap_f1.append(f1)

print('Bootstrap repetitions evaluated:', len(bootstrap_accuracy))
print('Mean accuracy:', round(np.mean(bootstrap_accuracy), 4))
print('Mean macro F1:', round(np.mean(bootstrap_f1), 4))

# Five-fold stratified cross-validation
cv = StratifiedKFold(
    n_splits=5,
    shuffle=True,
    random_state=SEED
)

cv_accuracy = []
cv_f1 = []

for fold, (fit_indices, validation_indices) in enumerate(
    cv.split(X_train, y_train),
    start=1
):
    model = DecisionTreeClassifier(
        max_depth=3,
        random_state=SEED
    )

    model.fit(
        X_train[fit_indices],
        y_train[fit_indices]
    )

    predictions = model.predict(
        X_train[validation_indices]
    )

    accuracy, f1 = evaluate_predictions(
        y_train[validation_indices],
        predictions
    )

    cv_accuracy.append(accuracy)
    cv_f1.append(f1)

    print(
        f'Fold {fold}: accuracy = {accuracy:.4f}, '
        f'macro F1 = {f1:.4f}'
    )

# Compare bootstrap and cross-validation results
resampling_table = pd.DataFrame({
    'Method': ['Bootstrap OOB', '5-fold cross-validation'],
    'Mean accuracy': [
        np.mean(bootstrap_accuracy),
        np.mean(cv_accuracy)
    ],
    'Accuracy SD': [
        np.std(bootstrap_accuracy, ddof=1),
        np.std(cv_accuracy, ddof=1)
    ],
    'Mean macro F1': [
        np.mean(bootstrap_f1),
        np.mean(cv_f1)
    ],
    'Macro F1 SD': [
        np.std(bootstrap_f1, ddof=1),
        np.std(cv_f1, ddof=1)
    ]
})

print(resampling_table.round(4).to_string(index=False))

resampling_table.plot(
    x='Method',
    y=['Mean accuracy', 'Mean macro F1'],
    kind='bar',
    ylim=(0, 1.05),
    rot=0,
    figsize=(8, 4)
)

plt.ylabel('Mean score')
plt.title('Bootstrapping and cross-validation')
plt.tight_layout()
plt.show()

# Select the best maximum depth using cross-validation
depths = range(1, 11)
training_errors = []
validation_errors = []

for depth in depths:
    fold_training_errors = []
    fold_validation_errors = []

    for fit_indices, validation_indices in cv.split(
        X_train,
        y_train
    ):
        model = DecisionTreeClassifier(
            max_depth=depth,
            random_state=SEED
        )

        model.fit(
            X_train[fit_indices],
            y_train[fit_indices]
        )

        training_predictions = model.predict(
            X_train[fit_indices]
        )

        validation_predictions = model.predict(
            X_train[validation_indices]
        )

        train_error = 1 - accuracy_score(
            y_train[fit_indices],
            training_predictions
        )

        validation_error = 1 - accuracy_score(
            y_train[validation_indices],
            validation_predictions
        )

        fold_training_errors.append(train_error)
        fold_validation_errors.append(validation_error)

    training_errors.append(np.mean(fold_training_errors))
    validation_errors.append(np.mean(fold_validation_errors))

best_depth = int(np.argmin(validation_errors)) + 1

print('Selected maximum depth:', best_depth)

print(
    pd.DataFrame({
        'Depth': list(depths),
        'Training error': training_errors,
        'Validation error': validation_errors
    }).round(4).to_string(index=False)
)

# Plot training and validation errors
plt.figure(figsize=(8, 4))

plt.plot(
    depths,
    training_errors,
    'o-',
    label='Training error'
)

plt.plot(
    depths,
    validation_errors,
    's-',
    label='Validation error'
)

plt.axvline(
    best_depth,
    color='grey',
    linestyle=':',
    label='Selected depth'
)

plt.xticks(list(depths))
plt.xlabel('Maximum tree depth')
plt.ylabel('Error = 1 - accuracy')
plt.title('Tree complexity and generalisation')
plt.legend()
plt.tight_layout()
plt.show()

# Create four classification models
single_tree = DecisionTreeClassifier(
    random_state=SEED
)

bagging = BaggingClassifier(
    estimator=DecisionTreeClassifier(random_state=SEED),
    n_estimators=100,
    random_state=SEED
)

boosting = AdaBoostClassifier(
    estimator=DecisionTreeClassifier(
        max_depth=1,
        random_state=SEED
    ),
    n_estimators=100,
    learning_rate=0.5,
    random_state=SEED
)

selected_tree = DecisionTreeClassifier(
    max_depth=best_depth,
    random_state=SEED
)

# Train all four models
single_tree.fit(X_train, y_train)
bagging.fit(X_train, y_train)
boosting.fit(X_train, y_train)
selected_tree.fit(X_train, y_train)

print('All four models have been trained.')

# Evaluate the models on the test dataset
model_names = [
    'Single tree',
    'Bagging',
    'AdaBoost',
    'CV-selected tree'
]

trained_models = [
    single_tree,
    bagging,
    boosting,
    selected_tree
]

results = []

for name, model in zip(model_names, trained_models):
    predictions = model.predict(X_test)

    accuracy, f1 = evaluate_predictions(
        y_test,
        predictions
    )

    precision = precision_score(
        y_test,
        predictions,
        labels=[0, 1, 2],
        average='macro',
        zero_division=0
    )

    recall = recall_score(
        y_test,
        predictions,
        labels=[0, 1, 2],
        average='macro',
        zero_division=0
    )

    results.append([
        name,
        accuracy,
        precision,
        recall,
        f1
    ])

test_table = pd.DataFrame(
    results,
    columns=[
        'Model',
        'Accuracy',
        'Macro precision',
        'Macro recall',
        'Macro F1'
    ]
)

print(test_table.round(4).to_string(index=False))

# Plot the final model comparison
test_table.plot(
    x='Model',
    y=[
        'Accuracy',
        'Macro precision',
        'Macro recall',
        'Macro F1'
    ],
    kind='bar',
    figsize=(9, 4),
    rot=0,
    ylim=(0, 1.08)
)

plt.ylabel('Test score')
plt.title('Final model comparison')
plt.legend(loc='lower right')
plt.tight_layout()
plt.show()
